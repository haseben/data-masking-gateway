[Unit]
Description=Data Masking Gateway (MCP)
After=network.target

[Service]
Type=simple
User=ai-gateway
Group=ai-gateway
WorkingDirectory=/opt/mcp-server
Environment=PATH=/opt/mcp-server/.venv/bin:/usr/bin
EnvironmentFile=/opt/mcp-server/.env
ExecStart=/opt/mcp-server/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8765 --workers 1
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/data-masking-gateway
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
