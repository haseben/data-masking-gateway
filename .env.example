# 数据库脱敏 MCP 网关 - 环境变量模板
# 复制为 .env 后填入真实值，权限设为 0600

# 数据库密码（datasource.yaml 中通过 ${DB_PASSWORD} 引用）
DB_PASSWORD=<你的数据库密码>

# 如有多个数据源，可分别设置密码
# DB_SECONDARY_PASSWORD=<第二数据源密码>

# HMAC 令牌化密钥（32字节 hex，用于脱敏令牌生成）
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
HMAC_SECRET=<64位hex密钥>

# 服务配置
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8765

# 审计日志路径
AUDIT_LOG_DIR=/var/log/data-masking-gateway
